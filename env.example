# Canlı site adresi (SEO sitemap, canonical URL ve Open Graph için zorunlu)
# Örnek: https://lisapelet.com veya https://siteniz.netlify.app
NEXT_PUBLIC_SITE_URL=https://lisapelet.com

# Google Analytics 4: https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HQ5Q71G9J3

# Telegram Bot: @BotFather üzerinden oluşturun
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Bildirimlerin gideceği chat ID (kişisel veya grup)
TELEGRAM_CHAT_ID=123456789

# Google reCAPTCHA v2: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=site_key_buraya
RECAPTCHA_SECRET_KEY=secret_key_buraya
